%%fakesection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                            ARGUMENT PROCESSING                             %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% We include "bt" in all of these to avoid collisions with external packages
% \bt@boolopt{name}{true|false} declares the switch \ifbtNAME
\newcommand{\bt@boolopt}[2]{%
  \expandafter\newif\csname ifbt#1\endcsname
  \csname bt#1#2\endcsname
  \DeclareOption{#1}{\csname bt#1true\endcsname}%
  \DeclareOption{no#1}{\csname bt#1false\endcsname}%
}
\bt@boolopt{author}{true}     % Set author to "Brendan Tang"
\bt@boolopt{boxthm}{true}     % Use tcolorbox-styled theorems
\bt@boolopt{colorsec}{true}   % Colorful section numbers
\bt@boolopt{fancy}{true}      % Page margin control
\bt@boolopt{hdr}{true}        % Page header control
\bt@boolopt{href}{true}       % Load hyperref package
\bt@boolopt{pkg}{true}        % If disabled, stops loading all non-essential pkg's
\bt@boolopt{secthm}{false}    % Label theorems within section
\bt@boolopt{setup}{true}      % Disable to turn off almost everything
\bt@boolopt{thm}{true}        % Whether to _define_ theorem environments
\newcommand{\bt@ifkoma}[2]{\@ifundefined{KOMAClassName}{#2}{#1}}

\ProcessOptions\relax
% if packages not loaded, turn off boxthm and colorsec
\ifbtpkg\else\btboxthmfalse\btcolorsecfalse\fi
% If no setup, turn off theorems
\ifbtsetup\else\btthmfalse\fi
% keytheorems is needed by boxthm too, even if no theorems are declared here.
\newif\ifbt@thmpkg
\ifbtthm\bt@thmpkgtrue\fi
\ifbtboxthm\bt@thmpkgtrue\fi


