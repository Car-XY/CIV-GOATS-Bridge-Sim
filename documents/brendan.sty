%                                   MACROS                                   %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Small commands
\usepackage{amsmath,amssymb,mathtools}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}
\DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
\DeclarePairedDelimiter{\ip}{\langle}{\rangle}

%%fakesection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                                 MAIN SETUP                                 %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ifbtsetup

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                              SET AUTHOR NAME                              %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtauthor
    \title{} % empty title to avoid crashes
    \author{Brendan Tang}
    \date{\today}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                              FONTS AND COLORS                             %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtpkg
    \KOMAoptions{fontsize=12pt}
    \usepackage[T1]{fontenc}
    \usepackage{newpxtext,newpxmath}
    \usepackage[scaled=0.88]{beramono}     % <-- monospace
    \IfFileExists{lato.sty}{\usepackage{lato}}{\usepackage[scaled=0.92]{helvet}}
    \newcommand{\sansheading}{\sffamily\bfseries}

    \PassOptionsToPackage{svgnames,dvipsnames,table}{xcolor}
    \usepackage{xcolor}
    \definecolor{ThmBlue}{RGB}{26,115,196}
    \definecolor{DefGreen}{RGB}{38,153,84}
    \definecolor{DefDark}{RGB}{18,92,46}
    \definecolor{ExOrange}{RGB}{214,120,30}
    \definecolor{ProblemBlue}{RGB}{16,34,112}
    \definecolor{ParaOrange}{RGB}{184,88,6}
    \definecolor{HeadSlate}{RGB}{22,58,84}
    \definecolor{LinkRose}{RGB}{160,28,84}
    \definecolor{NumAccent}{RGB}{174,40,58}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                         HYPERREF AND CLEVEREF                             %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtpkg
    \ifbthref
      \usepackage[colorlinks=true,pdfusetitle,linktoc=all,bookmarksnumbered=true]{hyperref}
      \hypersetup{urlcolor=LinkRose,linkcolor=LinkRose,citecolor=LinkRose}
    \fi
    \usepackage[capitalise,nameinlink]{cleveref}
  \fi

  \let\openbox\relax % fixing something.

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                         THEOREM STYLE DECLARATION                         %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  % Uses keytheorems + tcolorbox, as in evan.sty
  \ifbt@thmpkg
    \usepackage{keytheorems}
    \usepackage{mfirstuc}
    \@ifpackageloaded{hyperref}{\hypersetup{hypertexnames=false}}{}
  \fi
  \ifbtboxthm
    \usepackage{tcolorbox}
    \tcbuselibrary{skins,breakable}

    \tcbset{
      btbox/.style={ % shared by all
        enhanced jigsaw, breakable,
        left=8pt, right=8pt, top=5pt, bottom=5pt,
        before skip=0.9\baselineskip, after skip=0.9\baselineskip,
      },
      btbg/.style={colback=#1},
      btsidebar/.style={
        btbox, sharp corners, boxrule=0pt, frame hidden,
        left=10pt, right=8pt,
      },
      % --------------------------------------------------------
      bluebox/.style={
        btbox, btbg=ThmBlue!9, arc=2pt, colframe=ThmBlue!65, boxrule=0.6pt,
      },
      orangebox/.style={
        btbox, btbg=ExOrange!9, arc=2pt, colframe=ExOrange!65, boxrule=0.6pt,
      },
      greenbox/.style={
        btsidebar, btbg=DefGreen!5, borderline west={2.6pt}{0pt}{DefGreen},
      },
      blackbox/.style={
        btsidebar, btbg=black!5, borderline west={2.6pt}{0pt}{black},
      },
    }

    \declarekeytheoremstyle{thmbluebox}{
      headfont=\sansheading\color{ThmBlue!70!black},
      bodyfont=\normalfont,
      tcolorbox-no-titlebar={bluebox},
      headpunct={.},
      postheadspace={0.5em},
    }
    \declarekeytheoremstyle{thmorangebox}{
      headfont=\sansheading\color{ExOrange!80!black},
      bodyfont=\normalfont,
      tcolorbox-no-titlebar={orangebox},
      headpunct={.},
      postheadspace={0.5em},
    }
    \declarekeytheoremstyle{thmgreenbox}{
      headfont=\sansheading\color{DefDark},
      bodyfont=\normalfont,
      tcolorbox-no-titlebar={greenbox},
      headpunct={.},
      postheadspace={0.5em},
    }
    \declarekeytheoremstyle{thmblackbox}{
      headfont=\sansheading\color{black},
      bodyfont=\normalfont,
      tcolorbox-no-titlebar={blackbox},
      headpunct={.},
      postheadspace={0.5em},
    }
    \declarekeytheoremstyle{thminline}{
      headfont=\sansheading\color{HeadSlate},
      spaceabove=8pt plus 2pt minus 2pt,
      spacebelow=8pt plus 2pt minus 2pt,
      bodyfont=\normalfont,
      headpunct={.},
      postheadspace={0.5em},
    }
    \declarekeytheoremstyle{thmproblem}{
      headfont=\sansheading\color{ProblemBlue},
      spaceabove=8pt plus 2pt minus 2pt,
      spacebelow=8pt plus 2pt minus 2pt,
      bodyfont=\normalfont,
      headpunct={.},
      postheadspace={0.5em},
    }
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                         ACTUAL THEOREM DEFINITION                         %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtthm
    \ifbtsecthm
      \newcounter{thmcounter}[section]
      \renewcommand{\thethmcounter}{\thesection.\arabic{thmcounter}}
    \else
      \newcounter{thmcounter}
    \fi
    % #3 (the displayed name) defaults to the capitalized env name #1
    % \bt@thm: numbered, shares one counter (theorem, lemma, ...)
    \NewDocumentCommand{\bt@thm}{ m m O{\makefirstuc{#1}} }{%
      \ifbtboxthm
        \newkeytheorem{#1}[style=#2,name=#3,sibling=thmcounter]
        \newkeytheorem{#1*}[style=#2,name=#3,numbered=no]
      \else
        \newkeytheorem{#1}[name=#3,sibling=thmcounter]
        \newkeytheorem{#1*}[name=#3,numbered=no]
      \fi
    }
    % \bt@thmun: never numbered (definition, example, ...)
    \NewDocumentCommand{\bt@thmun}{ m m O{\makefirstuc{#1}} }{%
      \ifbtboxthm
        \newkeytheorem{#1}[style=#2,name=#3,numbered=no]
      \else
        \newkeytheorem{#1}[name=#3,numbered=no]
      \fi
    }
    \bt@thm{theorem}{thmbluebox}
    \bt@thm{lemma}{thmbluebox}
    \bt@thm{proposition}{thmbluebox}
    \bt@thm{corollary}{thmbluebox}
    \bt@thmun{definition}{thminline}
    \bt@thmun{example}{thmorangebox}
    \bt@thmun{remark}{thmgreenbox}
    \bt@thmun{foreword}{thmblackbox}
    \bt@thmun{note}{thmgreenbox}
    \bt@thmun{exercise}{thmblackbox}
    \bt@thmun{question}{thmblackbox}
    % problems have their own counter
    \ifbtboxthm
      \newkeytheorem{problem}[style=thmproblem,name=Problem]
    \else
      \newkeytheorem{problem}[name=Problem]
    \fi
    \ifbtpkg
      % These lines are exactly the ones not covered by cleveref
      \Crefname{exercise}{Exercise}{Exercises}
      \Crefname{problem}{Problem}{Problems}
      \Crefname{question}{Question}{Questions}
    \fi
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                      FANCY SECTION AND CHAPTER HEADS                      %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtpkg
    \bt@ifkoma{
      \setkomafont{disposition}{\normalfont\sansheading}
      \addtokomafont{paragraph}{\color{ParaOrange}}
      \setcounter{secnumdepth}{4}
      \renewcommand*{\theparagraph}{}
      \renewcommand*{\paragraphformat}{\P\enskip}
      \ifbtcolorsec
        % scale text by a factor (default 1.12) relative to the current size
        \newcommand{\numbigger}[2][1.12]{{\fontsize{\fpeval{#1*\f@size}}{\f@baselineskip}\selectfont #2}}
        \renewcommand*{\sectionformat}{{\color{NumAccent}\numbigger[1.5]{\thesection}}\enskip}
        \renewcommand*{\subsectionformat}{{\color{NumAccent}\numbigger{\S\,\thesubsection}}\enskip}
        \renewcommand*{\subsubsectionformat}{{\color{NumAccent}\numbigger{\S\,\thesubsubsection}}\enskip}
      \fi
    }{}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                    CONVENIENT QUALITY OF LIFE PACKAGES                    %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtpkg
    \usepackage{bm,mathrsfs,cancel}
    \usepackage{graphicx}
    \usepackage{tikz}
    \usetikzlibrary{arrows.meta,calc,positioning,angles,quotes,intersections,
                    shapes.geometric,decorations.pathreplacing,patterns}
    \usepackage{tikz-cd}
    \usepackage{tkz-euclide}
    \usepackage{pgfplots}
    \pgfplotsset{compat=1.18}

    \usepackage{enumitem}
    \setlist{itemsep=0.2em, topsep=0.3em, parsep=0pt}
    \usepackage{booktabs,array}
    \renewcommand{\arraystretch}{1.2}

    % Tiny optimizations:
    \usepackage{microtype}
    \setlength{\emergencystretch}{2em}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                   CONFIGURATION OF \maketitle FOR KOMA                    %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \bt@ifkoma{
    \setkomafont{title}{\color{HeadSlate}\bfseries\fontsize{26}{31}\selectfont}
    \setkomafont{author}{\large\scshape}
    \setkomafont{date}{\small\color{black!60}}
    % no header/footer on the title page
    \let\bt@maketitle\maketitle
    \renewcommand{\maketitle}{\bt@maketitle\thispagestyle{empty}}
  }{}
  \providecommand{\thetitle}{\@title}
  \providecommand{\theauthor}{\@author}
  \providecommand{\thedate}{\@date}

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                       CAPTIONS AND TABLE OF CONTENTS                      %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \bt@ifkoma{
    \KOMAoptions{captions=tableheading}
    \setkomafont{captionlabel}{\sansheading\color{HeadSlate}}
    \renewcommand*{\captionformat}{.\enskip}
    \setcounter{tocdepth}{2}
    \setkomafont{sectionentry}{\bfseries}
  }{}
  \ifbthref
    \let\bt@origtoc\tableofcontents
    \renewcommand{\tableofcontents}{%
      \begingroup\hypersetup{linkcolor=HeadSlate}\bt@origtoc\endgroup}
  \fi

  %%fakesubsection %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %                    PAGE LAYOUT (MARGINS, HEADING, ETC.)                   %
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  \ifbtfancy
    \usepackage[letterpaper,margin=1in,headheight=18pt,headsep=0.25in,footskip=0.4in]{geometry}
    \usepackage{setspace}
    \setstretch{1.1}
    \bt@ifkoma
    {
      \KOMAoptions{parskip=half}
      \usepackage[headsepline,singlespacing=true]{scrlayer-scrpage}
      \ifbthdr
        \clearpairofpagestyles
        \ihead{\textsc{\theauthor}}
        \ohead{\textit{\thetitle}}
        \cfoot*{\pagemark}
        \setkomafont{pageheadfoot}{\normalfont\small}
        \setkomafont{pagenumber}{\normalfont\small}
        \addtokomafont{headsepline}{\color{black!45}}
      \else
        % keep just the page number
        \pagestyle{plain}
      \fi
    }
    {
      \usepackage{fancyhdr}
      \setlength{\parskip}{0.5\baselineskip}
      \setlength{\parindent}{0pt}
      \ifbthdr
        \pagestyle{fancy}
        \lhead{\theauthor}
        \chead{}
        \rhead{\thetitle}
        \lfoot{}
        \cfoot{\thepage}
        \rfoot{}
      \fi
    }
  \fi
\fi